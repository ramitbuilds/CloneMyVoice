---
// Frequently Asked Questions in clean Rebus style with Schema.org FAQPage structured data
const faqs = [
  {
    q: "What is VocoSpeech?",
    a: "VocoSpeech is a free browser-based AI text-to-speech (TTS) and voice cloning platform that runs neural speech synthesis directly on your device. It allows creators, writers, educators, and developers to convert text to speech online for free and clone realistic speaking voices from a short audio sample—all with 100% privacy, zero cloud uploads, and no signup or account required."
  },
  {
    q: "Is VocoSpeech completely free and unlimited?",
    a: "Yes, VocoSpeech provides free unlimited TTS and voice cloning with no hidden paywalls, character caps, or subscription tiers. Because our neural audio model runs on-device using your browser's WebAssembly and WebGPU engine rather than costly remote servers, you can generate as many voiceovers, audiobooks, and cloned voice lines as you need."
  },
  {
    q: "How can I convert text to speech online for free?",
    a: "To convert text to speech for free, simply type or paste your script into the text prompt box on the VocoSpeech workspace, select one of the built-in natural voices (or your own cloned voice), fine-tune the Voice Tone slider, and click 'Generate Speech'. Your synthesized audio will stream and play back immediately without any account registration."
  },
  {
    q: "How can I clone my voice for free?",
    a: "You can clone your voice for free in three simple steps: switch to the Voice Cloning tab, click 'Record with Microphone', speak a 10 to 20 second sample into your mic (or read the practice sentence), name your custom voice profile, and save it. Your cloned voice profile is instantly saved in your local library and ready to speak any text prompt."
  },
  {
    q: "What is the difference between AI text-to-speech and voice cloning?",
    a: "AI text-to-speech (TTS) converts written words into spoken audio using pre-trained synthetic or studio voice personas. Voice cloning, on the other hand, is an advanced form of TTS that samples your real human voice recording to replicate your unique pitch, timbre, vocal cadence, and accent, allowing you to generate new speech in your own voice."
  },
  {
    q: "Can I use AI text-to-speech without signing up?",
    a: "Yes. VocoSpeech offers free text to speech with no signup required. You never have to provide an email address, create an account, or enter a credit card. You can start synthesizing natural sounding speech immediately upon visiting the website."
  },
  {
    q: "Can I clone my voice without paying or creating an account?",
    a: "Absolutely. VocoSpeech is a free voice cloner with no signup, no credit cards, and no token costs. You can clone your voice from audio in seconds and start generating realistic voiceovers instantly with zero barrier to entry."
  },
  {
    q: "How does AI voice cloning work?",
    a: "When you record a short voice sample, our client-side neural acoustic model analyzes your vocal frequencies, formant dynamics, and pitch characteristics. It extracts these acoustic embeddings into a lightweight reference profile that guides the text-to-speech engine to synthesize new sentences matching your voice's tone and rhythm."
  },
  {
    q: "Can I generate unlimited AI voiceovers for free?",
    a: "Yes. VocoSpeech delivers unlimited text to speech and unlimited voice cloning without daily quotas or monthly character restrictions. Whether you are generating 30-second shorts or full chapter narrations, you can produce unlimited free AI voiceovers directly in your browser."
  },
  {
    q: "Can I use VocoSpeech on my phone?",
    a: "Yes, VocoSpeech is fully responsive and works on modern mobile browsers (including Safari on iOS and Chrome on Android) that support WebAssembly and audio recording permissions. You can record voice clips, convert text to speech, and preview audio on both smartphones and tablets."
  },
  {
    q: "Is VocoSpeech's AI voice cloning private and secure?",
    a: "Yes, VocoSpeech is built with a privacy-first architecture. Unlike conventional cloud voice generators that send your biometric voice recordings to remote data centers, VocoSpeech processes your audio and text 100% locally on your machine. Your voice samples, custom profiles, and generated audio never touch external servers."
  },
  {
    q: "Does VocoSpeech store my voice recordings or generated audio?",
    a: "No. VocoSpeech does not store your voice recordings or generated speech on any server or cloud database. Custom voice profiles are saved exclusively in your browser's private local storage (IndexedDB / LocalStorage), which only you can access or clear."
  },
  {
    q: "Can I download AI-generated speech and cloned voice recordings?",
    a: "Yes. Once your voiceover is generated, click the 'Download Voice' button on the audio player to save a high-quality audio file (WAV) directly to your device. You can freely store, edit, or archive your downloaded audio tracks."
  },
  {
    q: "Can I use AI-generated voices for YouTube videos, Reels, and commercial projects?",
    a: "Yes. You retain ownership of the audio content you generate on VocoSpeech. You are free to use your downloaded voiceovers in YouTube videos, TikToks, Instagram Reels, podcasts, explainer videos, educational courses, and commercial media projects without royalties or licensing fees."
  },
  {
    q: "What languages does VocoSpeech support?",
    a: "VocoSpeech supports multiple languages, including English (Natural), German (Deutsch), Italian (Italiano), Portuguese (Português), and Spanish (Español). You can select your target language directly from the language selector in the text-to-speech studio."
  },
  {
    q: "How much audio is needed to clone my voice?",
    a: "You only need 10 to 20 seconds of clear, natural speech to clone your voice. Our modern zero-shot acoustic model extracts vocal characteristics from short recordings without requiring hours of training audio or specialized studio setups."
  },
  {
    q: "Can I clone someone else's voice with AI?",
    a: "You may only clone someone's voice if you have their explicit, informed permission to do so. VocoSpeech strictly prohibits unauthorized voice cloning, deepfakes, celebrity impersonation, or generating audio intended to deceive, defraud, or harass others."
  },
  {
    q: "Does VocoSpeech work directly in my browser?",
    a: "Yes. VocoSpeech is an entirely browser-based text-to-speech and voice cloning web application. It requires no software downloads, plugins, Python dependencies, or complex installations—just open your browser, write your script, and generate speech instantly."
  }
];

const faqStructuredData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((item) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
};
---

<section id="faq" class="py-16 md:py-24 border-t border-[#e5e0d4] bg-[#fbf9f5]">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-12">
      <span class="text-xs font-mono font-bold text-[#5c5b56] uppercase tracking-wider block mb-2">
        FAQ // Questions & Answers
      </span>
      <h2 class="text-3xl font-bold tracking-tight text-[#141413]">
        Frequently Asked Questions
      </h2>
      <p class="text-sm text-[#5c5b56] mt-2">
        Common questions about free text to speech, private voice cloning, and audio exports.
      </p>
    </div>

    <div class="space-y-4">
      {faqs.map((faq) => (
        <details class="group bg-white border-2 border-[#141413] p-5 [&_summary::-webkit-details-marker]:hidden cursor-pointer rebus-stamp-shadow-sm">
          <summary class="flex items-center justify-between font-bold text-sm text-[#141413] tracking-tight">
            <span>{faq.q}</span>
            <span class="ml-4 flex-shrink-0 text-[#141413] group-open:rotate-180 transition-transform">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="6 9 12 15 18 9" />
              </svg>
            </span>
          </summary>
          <p class="text-xs text-[#5c5b56] mt-3 pt-3 border-t border-[#e5e0d4] leading-relaxed font-medium">
            {faq.a}
          </p>
        </details>
      ))}
    </div>
  </div>

  <!-- FAQ Structured Data for Google Rich Snippets -->
  <script type="application/ld+json" set:html={JSON.stringify(faqStructuredData)} />
</section>
