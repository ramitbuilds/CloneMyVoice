---
// Frequently Asked Questions in clean Rebus style with Schema.org FAQPage structured data
const faqs = [
  {
    q: "What is VocoSpeech?",
    a: "VocoSpeech is a free browser-based text-to-speech and voice cloning studio. It runs neural speech synthesis on your local device using WebAssembly. You can generate speech from written text and clone realistic speaking voices from a short microphone sample while keeping your audio completely private on your hardware."
  },
  {
    q: "Is VocoSpeech completely free and unlimited?",
    a: "Yes. VocoSpeech provides free unlimited text to speech and voice cloning. Because the speech synthesis model runs directly inside your browser using WebAssembly and WebGPU, generation requires zero remote server computing. You can generate as many voiceovers, podcast segments, and cloned voice lines as your project demands."
  },
  {
    q: "How can I convert text to speech online for free?",
    a: "Paste your script into the prompt box, pick a voice persona such as Alba or Marius, set your preferred tone, and click Generate Speech. Your synthesized audio generates locally and starts playing immediately."
  },
  {
    q: "How can I clone my voice for free?",
    a: "Switch to the Voice Cloning tab, click Record with Microphone, and speak 10 to 20 seconds of natural speech. Check the recording in the preview player, enter a name for your profile, and save it. Your cloned voice profile saves to your local browser storage and appears in the voice selector immediately."
  },
  {
    q: "What is the difference between AI text-to-speech and voice cloning?",
    a: "Standard AI text to speech synthesizes written text using pre-trained studio voice models. Voice cloning samples your real speaking recording to map your pitch, tone, and cadence, allowing you to generate new voice tracks that sound like your own voice."
  },
  {
    q: "Can I use AI text-to-speech without signing up?",
    a: "Yes. VocoSpeech requires no account or registration. You can open the studio and start converting text to speech immediately upon visiting the website."
  },
  {
    q: "Can I clone my voice without paying or creating an account?",
    a: "Yes. VocoSpeech functions as a free voice cloner with no subscription tiers or token purchases. You can record a short sample, save your profile, and start generating custom voice tracks right away."
  },
  {
    q: "How does AI voice cloning work?",
    a: "When you record a voice sample, the client-side acoustic model analyzes your vocal frequencies and pitch patterns. It builds a lightweight reference embedding that guides the speech engine to synthesize new sentences matching your vocal tone and rhythm."
  },
  {
    q: "Can I generate unlimited AI voiceovers for free?",
    a: "Yes. VocoSpeech provides unlimited speech generation. You can produce 30-second video shorts or complete audio chapters directly in your browser without hitting character caps or daily limits."
  },
  {
    q: "Can I use VocoSpeech on my phone?",
    a: "Yes. VocoSpeech works on modern mobile browsers including Safari on iOS and Chrome on Android. You can record voice clips, synthesize speech, and download WAV audio on both smartphones and tablets."
  },
  {
    q: "Is VocoSpeech's AI voice cloning private and secure?",
    a: "Yes. VocoSpeech processes all speech generation and voice cloning locally on your hardware. Your voice recordings, custom profiles, and synthesized speech files stay on your device and are never sent to external servers."
  },
  {
    q: "Does VocoSpeech store my voice recordings or generated audio?",
    a: "No. Voice recordings and generated speech are never stored on external databases. Custom voice profiles are saved exclusively in your browser local storage, which you can clear at any time."
  },
  {
    q: "Can I download AI-generated speech and cloned voice recordings?",
    a: "Yes. Once your speech generation finishes, click Download Voice to save an uncompressed WAV audio file directly to your device for editing or archiving."
  },
  {
    q: "Can I use AI-generated voices for YouTube videos, Reels, and commercial projects?",
    a: "Yes. You own the audio files you generate with VocoSpeech. You can use your downloaded voiceovers in YouTube videos, social media reels, podcasts, educational courses, and commercial media projects without royalty fees."
  },
  {
    q: "What languages does VocoSpeech support?",
    a: "VocoSpeech supports English, German, Italian, Portuguese, and Spanish. You can select your target language directly from the language dropdown in the workspace."
  },
  {
    q: "How much audio is needed to clone my voice?",
    a: "You only need 10 to 20 seconds of clear speech to create a voice profile. The zero-shot acoustic model extracts pitch and timbre from brief microphone recordings without requiring long training sessions."
  },
  {
    q: "Can I clone someone else's voice with AI?",
    a: "You may only clone someone's voice with their explicit consent. VocoSpeech prohibits unauthorized voice duplication, impersonation, or creating deceptive audio content."
  },
  {
    q: "Does VocoSpeech work directly in my browser?",
    a: "Yes. VocoSpeech runs completely inside modern web browsers via WebAssembly. You do not need to install software, extensions, or background packages. Simply open the website, enter your text, and generate speech immediately."
  }
];

const faqStructuredData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((item) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
};
---

<section id="faq" class="scroll-mt-16 sm:scroll-mt-20 py-12 sm:py-16 md:py-24 border-t border-[#e5e0d4] bg-[#fbf9f5]">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-8 sm:mb-12">
      <span class="text-xs font-mono font-bold text-[#5c5b56] uppercase tracking-wider block mb-2">
        FAQ // Questions & Answers
      </span>
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-[#141413]">
        Frequently Asked Questions
      </h2>
      <p class="text-xs sm:text-sm text-[#5c5b56] mt-2">
        Common questions about free text to speech, private voice cloning, and audio exports.
      </p>
    </div>

    <div class="space-y-3 sm:space-y-4">
      {faqs.map((faq) => (
        <details class="group bg-white border-2 border-[#141413] p-3.5 sm:p-5 [&_summary::-webkit-details-marker]:hidden cursor-pointer rebus-stamp-shadow-sm select-none">
          <summary class="flex items-center justify-between font-bold text-sm sm:text-base text-[#141413] tracking-tight min-h-[40px] sm:min-h-0">
            <span class="pr-3 leading-snug">{faq.q}</span>
            <span class="ml-2 flex-shrink-0 text-[#141413] group-open:rotate-180 transition-transform">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="6 9 12 15 18 9" />
              </svg>
            </span>
          </summary>
          <p class="text-xs sm:text-sm text-[#5c5b56] mt-3 pt-3 border-t border-[#e5e0d4] leading-relaxed font-medium select-text">
            {faq.a}
          </p>
        </details>
      ))}
    </div>
  </div>

  <!-- FAQ Structured Data for Google Rich Snippets -->
  <script type="application/ld+json" set:html={JSON.stringify(faqStructuredData)} />
</section>
