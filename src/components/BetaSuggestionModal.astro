---
// BetaSuggestionModal.astro
// Floating feedback trigger & proactive suggestion modal for Voco Speech
---

<!-- Floating Feedback Trigger Button (Bottom Right) -->
<aside aria-label="Share feedback" class="fixed bottom-4 right-4 sm:bottom-5 sm:right-5 z-40 print:hidden">
  <button
    type="button"
    id="open-suggestion-modal-btn"
    class="group inline-flex items-center justify-center space-x-0 sm:space-x-2 w-10 h-10 sm:w-auto sm:h-auto p-2.5 sm:px-3.5 sm:py-2.5 bg-[#141413] text-white border border-[#141413] text-xs font-bold uppercase tracking-wider rebus-stamp-shadow hover:translate-x-0.5 hover:translate-y-0.5 hover:shadow-none active:translate-x-1 active:translate-y-1 transition-all cursor-pointer"
    title="Suggest a feature or report a bug"
    aria-label="Suggest a feature or report a bug"
  >
    <svg class="w-4 h-4 sm:w-3.5 sm:h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
    </svg>
    <span class="hidden sm:inline">Suggest / Report a bug</span>
  </button>
</aside>

<!-- Suggestion Modal Backdrop & Container -->
<div
  id="suggestion-modal-backdrop"
  class="fixed inset-0 z-50 bg-[#141413]/60 backdrop-blur-xs flex items-center justify-center p-3 sm:p-6 opacity-0 pointer-events-none transition-opacity duration-200"
  role="dialog"
  aria-modal="true"
  aria-labelledby="suggestion-modal-title"
>
  <div
    id="suggestion-modal-box"
    class="relative w-full max-w-lg bg-[#fbf9f5] border-2 border-[#141413] rebus-stamp-shadow p-4 sm:p-6 md:p-8 transform scale-95 transition-transform duration-200 max-h-[92vh] overflow-y-auto"
  >
    <!-- Modal Header -->
    <div class="flex items-start justify-between pb-4 border-b border-[#e5e0d4]">
      <div class="space-y-1 pr-4">
        <div class="flex items-center space-x-2">
          <span class="text-[10px] font-mono font-bold uppercase tracking-widest px-1.5 py-0.5 border border-[#141413] bg-[#f4f0e6] text-[#141413]">
            Feedback & bug reports
          </span>
          <span id="suggestion-badge-context" class="hidden text-[10px] font-mono uppercase tracking-wider text-[#5c5b56]">
            • Generation Complete
          </span>
        </div>
        <h3 id="suggestion-modal-title" class="text-2xl sm:text-3xl font-normal font-editorial-serif text-[#141413] leading-tight">
          Help shape Voco Speech
        </h3>
        <p id="suggestion-modal-subtitle" class="text-xs text-[#5c5b56] leading-relaxed">
          Found a bug or have an idea? Tell us what happened or what you would like to improve.
        </p>
      </div>

      <!-- Close X Button -->
      <button
        type="button"
        id="close-suggestion-modal-btn"
        class="shrink-0 p-1.5 border border-[#e5e0d4] text-[#5c5b56] hover:text-[#141413] hover:border-[#141413] bg-white transition-colors cursor-pointer"
        aria-label="Close feedback form"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Main Suggestion Form -->
    <form id="suggestion-form" novalidate class="mt-5 space-y-5">
      <!-- Quick Category Picker -->
      <div>
        <label class="block text-[11px] font-bold uppercase tracking-wider text-[#5c5b56] mb-2">
          What is your feedback about? (Optional)
        </label>
        <div class="flex flex-wrap gap-1.5" id="suggestion-topic-group">
          <button
            type="button"
            data-topic="Bug Report"
            class="topic-pill px-2.5 py-1 text-xs border border-[#e5e0d4] bg-white text-[#5c5b56] transition-colors cursor-pointer"
          >
            Report a bug
          </button>
          <button
            type="button"
            data-topic="Voice Quality"
            class="topic-pill px-2.5 py-1 text-xs border border-[#e5e0d4] bg-white text-[#5c5b56] transition-colors cursor-pointer"
          >
            Voice Quality
          </button>
          <button
            type="button"
            data-topic="New Voices"
            class="topic-pill px-2.5 py-1 text-xs border border-[#e5e0d4] bg-white text-[#5c5b56] transition-colors cursor-pointer"
          >
            New Voices & Accents
          </button>
          <button
            type="button"
            data-topic="Voice Cloning"
            class="topic-pill px-2.5 py-1 text-xs border border-[#e5e0d4] bg-white text-[#5c5b56] transition-colors cursor-pointer"
          >
            Voice Cloning
          </button>
          <button
            type="button"
            data-topic="New Feature"
            class="topic-pill px-2.5 py-1 text-xs border border-[#e5e0d4] bg-white text-[#5c5b56] transition-colors cursor-pointer"
          >
            New Feature
          </button>
          <button
            type="button"
            data-topic="Speed / Performance"
            class="topic-pill px-2.5 py-1 text-xs border border-[#e5e0d4] bg-white text-[#5c5b56] transition-colors cursor-pointer"
          >
            Speed / Performance
          </button>
        </div>
      </div>

      <!-- Suggestion Text Input -->
      <div>
        <div class="flex items-center justify-between mb-1.5">
          <label for="suggestion-text" class="text-xs font-bold uppercase tracking-wider text-[#141413]">
            Your Feedback <span class="text-red-600">*</span>
          </label>
          <span class="text-[11px] text-[#5c5b56]">Bugs, ideas, or improvements</span>
        </div>
        <textarea
          id="suggestion-text"
          name="suggestion"
          rows="4"
          required
          placeholder="For a bug: what were you trying to do, what happened, and did you see an error? Include your browser/device if possible. Ideas and feature requests are welcome too."
          class="w-full p-3 bg-white border border-[#141413] text-base sm:text-sm text-[#141413] focus:outline-none focus:ring-1 focus:ring-[#141413] resize-none"
        ></textarea>
        <div id="suggestion-empty-warning" class="hidden text-xs text-red-600 font-semibold mt-1">
          Please describe the bug or suggestion before submitting.
        </div>
      </div>

      <!-- Attribution Choice: Named (With Credit) vs Anonymous -->
      <div class="p-3 sm:p-4 bg-[#f4f0e6] border border-[#e5e0d4] space-y-3">
        <label class="block text-xs font-bold uppercase tracking-wider text-[#141413]">
          Attribution & Credit
        </label>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <!-- Option 1: Named with Credit -->
          <label class="attribution-label flex items-start space-x-2 p-2.5 border border-[#141413] bg-white cursor-pointer select-none">
            <input
              type="radio"
              name="attribution_type"
              value="credited"
              checked
              class="mt-0.5 accent-[#141413]"
              id="attrib-credited-radio"
            />
            <div class="text-xs">
              <span class="font-bold text-[#141413] block">Credit My Name</span>
              <span class="text-[11px] text-[#5c5b56] leading-tight block mt-0.5">
                Get credited on our changelog if your idea is built.
              </span>
            </div>
          </label>

          <!-- Option 2: Anonymous -->
          <label class="attribution-label flex items-start space-x-2 p-2.5 border border-[#e5e0d4] bg-white cursor-pointer select-none">
            <input
              type="radio"
              name="attribution_type"
              value="anonymous"
              class="mt-0.5 accent-[#141413]"
              id="attrib-anon-radio"
            />
            <div class="text-xs">
              <span class="font-bold text-[#141413] block">Submit Anonymously</span>
              <span class="text-[11px] text-[#5c5b56] leading-tight block mt-0.5">
                Keep this 100% private with no name attached.
              </span>
            </div>
          </label>
        </div>

        <!-- Name / Handle Input (Visible when Credited is selected) -->
        <div id="attribution-name-wrapper" class="pt-1">
          <label for="suggestion-author-name" class="block text-[11px] font-bold uppercase tracking-wider text-[#5c5b56] mb-1">
            Your Name, Handle, or Email (for credit) <span class="text-red-600">*</span>
          </label>
          <input
            type="text"
            id="suggestion-author-name"
            placeholder="e.g. Alex M. or @alexbuilds"
            class="w-full px-3 py-2 bg-white border border-[#141413] text-base sm:text-xs text-[#141413] focus:outline-none focus:ring-1 focus:ring-[#141413]"
          />
          <div id="suggestion-name-empty-warning" class="hidden text-xs text-red-600 font-semibold mt-1">
            Please enter your name/handle for credit (or select Submit Anonymously).
          </div>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-col-reverse sm:flex-row items-stretch sm:items-center sm:justify-between gap-2.5 sm:gap-3 pt-2">
        <button
          type="button"
          id="skip-suggestion-btn"
          class="w-full sm:w-auto px-4 py-2.5 sm:py-2 text-xs font-semibold uppercase tracking-wider text-[#5c5b56] hover:text-[#141413] transition-colors cursor-pointer text-center"
        >
          Skip for now
        </button>

        <button
          type="submit"
          id="submit-suggestion-btn"
          class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-2.5 border border-[#141413] text-xs font-bold uppercase tracking-wider bg-[#141413] text-white hover:bg-neutral-800 transition-all rebus-stamp-shadow-sm active:translate-x-0.5 active:translate-y-0.5 active:shadow-none cursor-pointer"
        >
          <span>Send Feedback</span>
          <span class="ml-1.5">→</span>
        </button>
      </div>
    </form>

    <!-- Success Feedback View (Hidden initially) -->
    <div id="suggestion-success-view" class="hidden mt-6 text-center space-y-4 py-4">
      <div class="w-12 h-12 mx-auto bg-emerald-600 text-white flex items-center justify-center border border-[#141413] rebus-stamp-shadow-sm">
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      </div>

      <div class="space-y-1">
        <h4 class="text-2xl font-editorial-serif text-[#141413]">
          Thank you for your feedback!
        </h4>
        <p id="suggestion-success-desc" class="text-xs text-[#5c5b56] max-w-sm mx-auto leading-relaxed">
          Your feedback directly informs our next release.
        </p>
      </div>

      <div class="pt-2 text-[11px] text-[#5c5b56] leading-relaxed">
        Direct questions or ideas?<br />
        You can also email us anytime at:<br />
        <a href="mailto:hi@vocospeech.xyz" class="font-bold underline text-[#141413] hover:text-black">
          hi@vocospeech.xyz
        </a>
      </div>

      <div class="pt-3">
        <button
          type="button"
          id="close-success-btn"
          class="px-6 py-2 border border-[#141413] text-xs font-bold uppercase tracking-wider bg-[#141413] text-white hover:bg-neutral-800 transition-all rebus-stamp-shadow-sm cursor-pointer"
        >
          Back to Voco Speech
        </button>
      </div>
    </div>
  </div>
</div>

<script is:inline>
(function() {
  const backdrop = document.getElementById("suggestion-modal-backdrop");
  const modalBox = document.getElementById("suggestion-modal-box");
  const openBtn = document.getElementById("open-suggestion-modal-btn");
  const closeBtn = document.getElementById("close-suggestion-modal-btn");
  const skipBtn = document.getElementById("skip-suggestion-btn");
  const closeSuccessBtn = document.getElementById("close-success-btn");
  const form = document.getElementById("suggestion-form");
  const successView = document.getElementById("suggestion-success-view");
  const successDesc = document.getElementById("suggestion-success-desc");
  const titleEl = document.getElementById("suggestion-modal-title");
  const subtitleEl = document.getElementById("suggestion-modal-subtitle");
  const badgeContextEl = document.getElementById("suggestion-badge-context");
  const authorNameInput = document.getElementById("suggestion-author-name");
  const nameWrapper = document.getElementById("attribution-name-wrapper");
  const creditedRadio = document.getElementById("attrib-credited-radio");
  const anonRadio = document.getElementById("attrib-anon-radio");
  const topicPills = document.querySelectorAll(".topic-pill");

  let selectedTopic = "";
  let modalOpen = false;

  // Manual feedback stays available; automatic feedback waits for a quiet moment.
  window.openSuggestionModal = function(options = {}) {
    if (modalOpen) return;
    modalOpen = true;
    window.vocoTrack?.('feedback_opened', { source: options.trigger === 'idle_usage' ? 'idle_usage' : 'manual' });
    sessionStorage.setItem("voco_suggestion_shown", "true");

    // Reset view
    if (form) form.classList.remove("hidden");
    if (successView) successView.classList.add("hidden");

    if (options.title && titleEl) {
      titleEl.textContent = options.title;
    } else if (titleEl) {
      titleEl.textContent = "Help shape Voco Speech";
    }

    if (options.subtitle && subtitleEl) {
      subtitleEl.textContent = options.subtitle;
    } else if (subtitleEl) {
      subtitleEl.textContent = "Found a bug or have an idea? Tell us what happened or what you would like to improve.";
    }

    if (options.trigger === "generation" && badgeContextEl) {
      badgeContextEl.classList.remove("hidden");
      badgeContextEl.textContent = "• Generation Complete";
    } else if (options.trigger === "voice_saved" && badgeContextEl) {
      badgeContextEl.classList.remove("hidden");
      badgeContextEl.textContent = "• Voice Saved";
    } else if (badgeContextEl) {
      badgeContextEl.classList.add("hidden");
    }

    if (backdrop && modalBox) {
      backdrop.classList.remove("opacity-0", "pointer-events-none");
      backdrop.classList.add("opacity-100");
      modalBox.classList.remove("scale-95");
      modalBox.classList.add("scale-100");
      document.body.style.overflow = "hidden";
    }

    // Auto-focus suggestion textarea
    setTimeout(() => {
      const textarea = document.getElementById("suggestion-text");
      if (textarea) textarea.focus();
    }, 150);
  };

  function closeSuggestionModal() {
    if (modalOpen) window.vocoTrack?.('feedback_closed');
    modalOpen = false;
    if (backdrop && modalBox) {
      backdrop.classList.add("opacity-0", "pointer-events-none");
      backdrop.classList.remove("opacity-100");
      modalBox.classList.add("scale-95");
      modalBox.classList.remove("scale-100");
      document.body.style.overflow = "";
    }
    // Record dismiss timestamp
    sessionStorage.setItem("voco_suggestion_dismissed", String(Date.now()));
  }

  // Event Listeners
  if (openBtn) {
    openBtn.addEventListener("click", () => window.openSuggestionModal());
  }

  const navBtn = document.getElementById("nav-suggestion-btn");
  if (navBtn) {
    navBtn.addEventListener("click", () => window.openSuggestionModal());
  }

  if (closeBtn) closeBtn.addEventListener("click", closeSuggestionModal);
  if (skipBtn) skipBtn.addEventListener("click", closeSuggestionModal);
  if (closeSuccessBtn) closeSuccessBtn.addEventListener("click", closeSuggestionModal);

  // Close when clicking outside modal box
  if (backdrop) {
    backdrop.addEventListener("click", (e) => {
      if (e.target === backdrop) closeSuggestionModal();
    });
  }

  // ESC key to close
  window.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && modalOpen) {
      closeSuggestionModal();
    }
  });

  // Topic pills selection
  topicPills.forEach((pill) => {
    pill.addEventListener("click", () => {
      const topic = pill.getAttribute("data-topic");
      if (selectedTopic === topic) {
        selectedTopic = "";
        pill.classList.remove("is-active-topic");
      } else {
        topicPills.forEach((p) => p.classList.remove("is-active-topic"));
        selectedTopic = topic;
        pill.classList.add("is-active-topic");
      }
    });
  });

  // =========================================================================
  // GOOGLE FORMS INTEGRATION
  // Connected Google Form for Voco Speech Suggestions:
  // - Suggestion: entry.280084409 (Paragraph)
  // - Name / Credit: entry.1838810261 (Short answer: filled if credited, left empty if anonymous)
  // - Topic: entry.1046555020 (Short answer: selected category)
  // =========================================================================
  const GOOGLE_FORM_ACTION_URL = "https://docs.google.com/forms/d/e/1FAIpQLSdH5kDXP_5UhJCN1bOhm2h3ayqer3XZdw_uDK7GLdUyP_igaQ/formResponse"; 
  const GOOGLE_FORM_ENTRIES = {
    suggestion: "entry.280084409",
    authorName: "entry.1838810261",
    topic: "entry.1046555020",
  };

  // Attribution radio toggle
  function updateAttributionState() {
    const isCredited = creditedRadio && creditedRadio.checked;
    const creditedCard = creditedRadio?.closest("label");
    const anonCard = anonRadio?.closest("label");

    if (creditedCard && anonCard) {
      if (isCredited) {
        creditedCard.classList.remove("border-[#e5e0d4]");
        creditedCard.classList.add("border-[#141413]");
        anonCard.classList.remove("border-[#141413]");
        anonCard.classList.add("border-[#e5e0d4]");
      } else {
        anonCard.classList.remove("border-[#e5e0d4]");
        anonCard.classList.add("border-[#141413]");
        creditedCard.classList.remove("border-[#141413]");
        creditedCard.classList.add("border-[#e5e0d4]");
      }
    }

    if (nameWrapper) {
      if (isCredited) {
        nameWrapper.classList.remove("hidden");
        if (authorNameInput) authorNameInput.disabled = false;
      } else {
        nameWrapper.classList.add("hidden");
        if (authorNameInput) {
          authorNameInput.disabled = true;
          authorNameInput.value = "";
        }
      }
    }
  }

  if (creditedRadio) creditedRadio.addEventListener("change", updateAttributionState);
  if (anonRadio) anonRadio.addEventListener("change", updateAttributionState);

  // Form submission: INSTANT OPTIMISTIC SUCCESS
  if (form) {
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const textInput = document.getElementById("suggestion-text");
      const warningEl = document.getElementById("suggestion-empty-warning");
      const textVal = textInput?.value?.trim() || "";

      if (!textVal) {
        window.vocoTrack?.('feedback_validation_error', { field: 'suggestion' });
        if (textInput) {
          textInput.focus();
          textInput.classList.remove("border-[#141413]");
          textInput.classList.add("border-2", "border-red-600");
        }
        if (warningEl) warningEl.classList.remove("hidden");
        return;
      }

      if (warningEl) warningEl.classList.add("hidden");
      if (textInput) {
        textInput.classList.remove("border-2", "border-red-600");
        textInput.classList.add("border-[#141413]");
      }

      const isCredited = creditedRadio && creditedRadio.checked;
      const authorName = isCredited ? (authorNameInput?.value?.trim() || "") : "";
      const nameWarningEl = document.getElementById("suggestion-name-empty-warning");

      // When "Credit My Name" is selected, require the author's name/handle
      if (isCredited && !authorName) {
        window.vocoTrack?.('feedback_validation_error', { field: 'attribution' });
        if (authorNameInput) {
          authorNameInput.focus();
          authorNameInput.classList.remove("border-[#141413]");
          authorNameInput.classList.add("border-2", "border-red-600");
        }
        if (nameWarningEl) nameWarningEl.classList.remove("hidden");
        return;
      }

      if (nameWarningEl) nameWarningEl.classList.add("hidden");
      if (authorNameInput) {
        authorNameInput.classList.remove("border-2", "border-red-600");
        authorNameInput.classList.add("border-[#141413]");
      }

      const suggestionData = {
        id: "sug_" + Date.now(),
        text: textVal,
        topic: selectedTopic || "",
        attribution: isCredited ? "credited" : "anonymous",
        authorName: authorName || "Anonymous",
        createdAt: new Date().toISOString(),
        url: window.location.href,
      };
      const analyticsTopics = { 'Bug Report': 'bug_report', 'Voice Quality': 'voice_quality', 'New Voices': 'voices_accents', 'Voice Cloning': 'voice_cloning', 'New Feature': 'new_feature', 'Speed / Performance': 'speed_performance' };
      window.vocoTrack?.('feedback_submitted', { topic: analyticsTopics[selectedTopic] || 'none', attribution: isCredited ? 'credited' : 'anonymous' });

      // 1. INSTANT SUCCESS: Transition UI immediately without waiting for network!
      form.classList.add("hidden");
      if (successView) successView.classList.remove("hidden");

      if (successDesc) {
        if (isCredited && authorName) {
          successDesc.textContent = `Your feedback has been logged under "${authorName}". Thank you for helping improve Voco Speech!`;
        } else {
          successDesc.textContent = "Your anonymous feedback has been logged. Thank you for helping make Voco Speech better!";
        }
      }

      // Mark suggestion submitted in this session
      sessionStorage.setItem("voco_suggestion_submitted", "true");

      // Store in local browser backup
      try {
        const stored = JSON.parse(localStorage.getItem("voco_user_suggestions") || "[]");
        stored.push(suggestionData);
        localStorage.setItem("voco_user_suggestions", JSON.stringify(stored));
      } catch (err) {
        console.warn("Could not save to localStorage:", err);
      }

      // 2. BACKGROUND FIRE-AND-FORGET: Deliver to Google Forms without blocking the user
      if (GOOGLE_FORM_ACTION_URL && GOOGLE_FORM_ACTION_URL.includes("formResponse")) {
        const formPayload = new URLSearchParams();
        if (GOOGLE_FORM_ENTRIES.suggestion) {
          formPayload.append(GOOGLE_FORM_ENTRIES.suggestion, textVal);
        }
        if (GOOGLE_FORM_ENTRIES.authorName && authorName) {
          formPayload.append(GOOGLE_FORM_ENTRIES.authorName, authorName);
        }
        if (GOOGLE_FORM_ENTRIES.topic && selectedTopic) {
          formPayload.append(GOOGLE_FORM_ENTRIES.topic, selectedTopic);
        }

        fetch(GOOGLE_FORM_ACTION_URL, {
          method: "POST",
          mode: "no-cors",
          headers: { "Content-Type": "application/x-www-form-urlencoded" },
          body: formPayload.toString(),
        }).catch((postErr) => {
          window.vocoTrack?.('feedback_delivery_failed');
          console.warn("Background Google Form delivery note:", postErr);
        });
      }

      // Reset fields
      form.reset();
      selectedTopic = "";
      topicPills.forEach((p) => p.classList.remove("is-active-topic"));
      updateAttributionState();
    });
  }

  // Clear warning when typing in suggestion text
  const suggestionTextEl = document.getElementById("suggestion-text");
  if (suggestionTextEl) {
    suggestionTextEl.addEventListener("input", () => {
      const warningEl = document.getElementById("suggestion-empty-warning");
      if (warningEl) warningEl.classList.add("hidden");
      suggestionTextEl.classList.remove("border-2", "border-red-600");
      suggestionTextEl.classList.add("border-[#141413]");
    });
  }

  // Clear name warning when typing in name input
  if (authorNameInput) {
    authorNameInput.addEventListener("input", () => {
      const nameWarningEl = document.getElementById("suggestion-name-empty-warning");
      if (nameWarningEl) nameWarningEl.classList.add("hidden");
      authorNameInput.classList.remove("border-2", "border-red-600");
      authorNameInput.classList.add("border-[#141413]");
    });
  }

  let lastActivity = Date.now();
  for (const event of ["pointerdown", "keydown", "input"]) {
    document.addEventListener(event, () => { lastActivity = Date.now(); }, { passive: true });
  }

  // Wait two minutes and at least 30 seconds of quiet; never interrupt a voice task.
  function offerFeedbackWhenIdle() {
    const alreadySubmitted = sessionStorage.getItem("voco_suggestion_submitted");
    const alreadyShown = sessionStorage.getItem("voco_suggestion_shown");
    const dismissed = sessionStorage.getItem("voco_suggestion_dismissed");
    if (alreadySubmitted || alreadyShown || dismissed || modalOpen) return;

    const studio = window.pocketTTS;
    const busy = document.hidden ||
      (studio && (!studio.isWorkerReady || studio.isGenerating || studio.isRecording)) ||
      [...document.querySelectorAll("audio")].some(audio => !audio.paused && !audio.ended) ||
      document.activeElement?.matches("input, textarea, select, [contenteditable='true']");
    if (busy) lastActivity = Date.now();
    if (busy || Date.now() - lastActivity < 30_000) {
      setTimeout(offerFeedbackWhenIdle, 5_000);
      return;
    }

    window.openSuggestionModal({
      trigger: "idle_usage",
      title: "How is Voco Speech working?",
      subtitle: "Have an idea or found something that isn't working? Share a suggestion or report a bug."
    });
  }
  setTimeout(offerFeedbackWhenIdle, 120_000);
})();
</script>

