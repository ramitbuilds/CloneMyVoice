---
// Features section styled as an asymmetrical Bento Grid in Rebus design aesthetic (strictly no emojis, clean SVGs, no pills)
---

<section id="features" class="scroll-mt-16 sm:scroll-mt-20 py-12 sm:py-16 md:py-24 border-t border-[#e5e0d4] bg-[#fbf9f5]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header with Meaningful Copy -->
    <div class="max-w-3xl mb-8 sm:mb-12">
      <span class="text-xs font-bold text-[#5c5b56] uppercase tracking-wider block mb-2">
        // Capabilities
      </span>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight text-[#141413] mb-3 text-balance">
        Built for fast, natural voice creation.
      </h2>
      <p class="text-sm sm:text-base text-[#5c5b56] leading-relaxed">
        Generate lifelike speech, duplicate your own voice, and export crisp audio directly in your browser.
      </p>
    </div>

    <!-- Bento Grid Layout: 12-Column Responsive Layout (No Pills) -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-4 sm:gap-6">
      
      <!-- Card 01: Wide Bento Tile (7 cols on lg, 6 on md) -->
      <div class="md:col-span-6 lg:col-span-7 bg-white border-2 border-[#141413] p-4 sm:p-6 md:p-8 rebus-stamp-shadow-sm flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-4 sm:mb-6">
            <div class="w-9 h-9 sm:w-10 sm:h-10 border border-[#141413] bg-[#141413] text-white flex items-center justify-center">
              <svg class="w-4 h-4 sm:w-5 sm:h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 2v20M17 5v14M7 8v8M22 10v4M2 10v4" />
              </svg>
            </div>
            <span class="text-xs font-bold text-[#5c5b56] uppercase tracking-wider">
              01 // SPEECH ENGINE
            </span>
          </div>

          <h3 class="text-lg sm:text-xl font-bold text-[#141413] uppercase tracking-tight mb-2">
            Natural Sounding Speech
          </h3>
          <p class="text-sm text-[#5c5b56] leading-relaxed">
            Turn written text into natural sounding text to speech with authentic human cadence, expressive inflection, and fluid pacing. Perfect for video narration, audiobooks, and AI voiceovers.
          </p>
        </div>
      </div>

      <!-- Card 02: Medium Bento Tile (5 cols on lg, 6 on md) -->
      <!-- Voice Cloning without mentioning background sounds/hum removal method -->
      <div class="md:col-span-6 lg:col-span-5 bg-white border-2 border-[#141413] p-4 sm:p-6 md:p-8 rebus-stamp-shadow-sm flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-4 sm:mb-6">
            <div class="w-9 h-9 sm:w-10 sm:h-10 border border-[#141413] bg-[#f4f0e6] text-[#141413] flex items-center justify-center">
              <svg class="w-4 h-4 sm:w-5 sm:h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z" />
                <path d="M19 10v2a7 7 0 0 1-14 0v-2" />
                <line x1="12" y1="19" x2="12" y2="22" />
              </svg>
            </div>
            <span class="text-xs font-bold text-[#5c5b56] uppercase tracking-wider">
              02 // CLONING
            </span>
          </div>

          <h3 class="text-lg sm:text-xl font-bold text-[#141413] uppercase tracking-tight mb-2">
            Free AI Voice Cloning
          </h3>
          <p class="text-sm text-[#5c5b56] leading-relaxed">
            Clone your voice from audio in seconds using a short reading sample from your microphone. Our AI voice cloner matches your unique timbre, pitch, and speaking cadence.
          </p>
        </div>
      </div>

      <!-- Card 03: Bottom Bento Tile (4 cols on lg, 6 on md) -->
      <div class="md:col-span-6 lg:col-span-4 bg-white border-2 border-[#141413] p-4 sm:p-6 md:p-8 rebus-stamp-shadow-sm flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-4">
            <div class="w-9 h-9 sm:w-10 sm:h-10 border border-[#141413] bg-[#f4f0e6] text-[#141413] flex items-center justify-center">
              <svg class="w-4 h-4 sm:w-5 sm:h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10" />
                <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" />
                <path d="M2 12h20" />
              </svg>
            </div>
            <span class="text-xs font-bold text-[#5c5b56] uppercase tracking-wider">
              03 // MULTILINGUAL
            </span>
          </div>

          <h3 class="text-base sm:text-lg font-bold text-[#141413] uppercase tracking-tight mb-2">
            5 Major Languages
          </h3>
          <p class="text-sm text-[#5c5b56] leading-relaxed">
            Generate speech online in English, Spanish, German, Italian, and Portuguese with authentic regional intonation.
          </p>
        </div>
      </div>

      <!-- Card 04: Bottom Bento Tile (4 cols on lg, 6 on md) -->
      <div class="md:col-span-6 lg:col-span-4 bg-white border-2 border-[#141413] p-4 sm:p-6 md:p-8 rebus-stamp-shadow-sm flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-4">
            <div class="w-9 h-9 sm:w-10 sm:h-10 border border-[#141413] bg-[#f4f0e6] text-[#141413] flex items-center justify-center">
              <svg class="w-4 h-4 sm:w-5 sm:h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="11" width="18" height="11" rx="0" ry="0"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
            </div>
            <span class="text-xs font-bold text-[#5c5b56] uppercase tracking-wider">
              04 // PRIVACY
            </span>
          </div>

          <h3 class="text-base sm:text-lg font-bold text-[#141413] uppercase tracking-tight mb-2">
            Private & Device-Only
          </h3>
          <p class="text-sm text-[#5c5b56] leading-relaxed">
            Private AI voice cloning running 100% inside your browser. No voice clips, audio files, or text ever leave your device or touch external cloud servers.
          </p>
        </div>
      </div>

      <!-- Card 05: Bottom Bento Tile (4 cols on lg, 12 on md) -->
      <div class="md:col-span-12 lg:col-span-4 bg-white border-2 border-[#141413] p-4 sm:p-6 md:p-8 rebus-stamp-shadow-sm flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-4">
            <div class="w-9 h-9 sm:w-10 sm:h-10 border border-[#141413] bg-[#f4f0e6] text-[#141413] flex items-center justify-center">
              <svg class="w-4 h-4 sm:w-5 sm:h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
              </svg>
            </div>
            <span class="text-xs font-bold text-[#5c5b56] uppercase tracking-wider">
              05 // UNLIMITED
            </span>
          </div>

          <h3 class="text-base sm:text-lg font-bold text-[#141413] uppercase tracking-tight mb-2">
            Free Unlimited TTS
          </h3>
          <p class="text-sm text-[#5c5b56] leading-relaxed">
            No signup, no subscriptions, and no character quotas. Convert text to speech and create unlimited voice cloning projects with zero restrictions.
          </p>
        </div>
      </div>

    </div>
  </div>
</section>
