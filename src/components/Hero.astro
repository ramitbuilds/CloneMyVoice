---
// Hero section styled in clean Rebus editorial aesthetic: bold typography, no emojis, no pills or badge chips
---

<section data-analytics-section="hero" class="relative pt-10 pb-12 sm:pt-16 sm:pb-16 md:pt-24 md:pb-24 rebus-grid-bg border-b border-[#e5e0d4] overflow-hidden">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
    
    <!-- Semantic Eyebrow Tag -->
    <div class="inline-flex items-center space-x-2 px-2.5 sm:px-3 py-1 border border-[#141413] bg-[#f4f0e6] text-[#141413] text-[11px] sm:text-xs font-mono font-bold uppercase tracking-wider mb-4 sm:mb-6 rebus-stamp-shadow-sm select-none">
      <img src="/icon/dark_background_icon.png" alt="" class="w-3.5 h-3.5 rounded-xs dark:hidden inline-block" />
      <img src="/icon/white_background_icon.png" alt="" class="w-3.5 h-3.5 rounded-xs hidden dark:inline-block" />
      <span>Free TTS & Free Voice Cloning</span>
    </div>

    <!-- Main Headline with Editorial Serif Accent: Strictly on 2 separate lines on all devices -->
    <h1 class="text-3xl sm:text-5xl md:text-6xl font-bold tracking-tight text-[#141413] leading-[1.18] sm:leading-[1.12] mb-4 sm:mb-6">
      <span class="block">Free text to speech.</span>
      <span class="block font-editorial-serif font-normal italic mt-1 sm:mt-2">Instant, private voice cloning.</span>
    </h1>

    <!-- Subtitle: Direct, human, benefit-first with zero AI tells -->
    <p class="text-sm sm:text-base md:text-lg text-[#5c5b56] max-w-2xl mx-auto text-pretty leading-relaxed">
      Convert text to speech online free or clone your voice from a short audio clip. Our browser-based speech engine synthesizes natural sounding audio directly on your device. Free and unlimited, with no signup required.
    </p>

    <div class="mt-6 sm:mt-8 flex justify-center">
      <a
        id="product-hunt-hero-badge"
        href="https://www.producthunt.com/products/voco-speech-2?embed=true&amp;utm_source=badge-featured&amp;utm_medium=badge&amp;utm_campaign=badge-voco-speech-2"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block max-w-full focus-visible:outline-2 focus-visible:outline-offset-4"
      >
        <img
          src="https://api.producthunt.com/widgets/embed-image/v1/featured.svg?post_id=1285161&amp;theme=light&amp;t=1792399458030"
          alt="Voco Speech - Free forever. Unlimited TTS &amp; voice cloning. No signup. | Product Hunt"
          width="250"
          height="54"
          decoding="async"
          class="block max-w-full h-auto"
        />
      </a>
    </div>

  </div>
</section>
