---
// Navbar component in pure Vercel light design system
---

<header class="sticky top-0 z-40 w-full border-b border-[#ebebeb] bg-[#fafafa]/90 backdrop-blur-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Brand / Logo -->
    <div class="flex items-center space-x-3">
      <a href="/" class="flex items-center space-x-2.5 group focus-visible:ring-2 focus-visible:ring-[#0070f3] rounded-md">
        <!-- Soundwave badge -->
        <div class="w-8 h-8 rounded-md bg-[#171717] text-white flex items-center justify-center font-bold shadow-xs group-hover:scale-105 transition-transform">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2v20M17 5v14M7 8v8M22 10v4M2 10v4" />
          </svg>
        </div>
        <span class="text-base font-semibold tracking-tight text-[#171717]">Clone My Voice</span>
      </a>
    </div>

    <!-- Navigation / Actions -->
    <div class="flex items-center space-x-4">
      <a 
        href="#workbench" 
        class="hidden md:inline-flex text-xs font-medium text-[#4d4d4d] hover:text-[#171717] px-3 py-1.5 transition-colors"
      >
        Workbench
      </a>
      <a 
        href="#features" 
        class="hidden md:inline-flex text-xs font-medium text-[#4d4d4d] hover:text-[#171717] px-3 py-1.5 transition-colors"
      >
        Features
      </a>
      <a 
        href="#faq" 
        class="hidden sm:inline-flex text-xs font-medium text-[#4d4d4d] hover:text-[#171717] px-3 py-1.5 transition-colors"
      >
        FAQ
      </a>

      <!-- Action Button (No pill) -->
      <a
        href="#workbench"
        class="inline-flex items-center px-3.5 py-1.5 rounded-md text-xs font-medium bg-[#171717] text-white hover:bg-neutral-800 transition-colors shadow-xs"
      >
        <span>Start Creating</span>
      </a>
    </div>
  </div>
</header>
