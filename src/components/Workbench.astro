---
// Main interactive Workbench: Text-to-Speech and AI Voice Studio in Rebus design aesthetic (no emojis, no pills)
---

<section id="workbench" class="scroll-mt-16 sm:scroll-mt-20 py-8 sm:py-12 md:py-16 bg-[#fbf9f5]">
  <div class="max-w-5xl mx-auto px-3 sm:px-6 lg:px-8">
    
    <!-- Workbench Studio Container Card -->
    <div class="bg-white border-2 border-[#141413] rebus-stamp-shadow-lg p-3.5 sm:p-6 md:p-8 relative">

      <!-- Header Bar: Centered Switcher Tabs -->
      <div class="flex items-center justify-center pb-4 sm:pb-6 mb-4 sm:mb-6 border-b border-[#e5e0d4]">
        <!-- Mode Switcher Tabs (Segmented control, strictly rectangular, no pills) -->
        <div class="inline-flex w-full sm:w-auto p-1 bg-[#f4f0e6] border border-[#141413]">
          <button
            id="tab-tts"
            type="button"
            class="flex-1 sm:flex-initial is-active px-3 sm:px-4 py-2 sm:py-1.5 text-xs font-bold uppercase tracking-wider bg-[#171717] text-white transition-all shadow-xs focus-visible:ring-2 focus-visible:ring-[#141413] cursor-pointer text-center"
          >
            <span class="inline-flex items-center justify-center space-x-1.5 sm:space-x-2">
              <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M12 2v20M17 5v14M7 8v8M22 10v4M2 10v4" />
              </svg>
              <span class="truncate">Text-to-Speech</span>
            </span>
          </button>

          <button
            id="tab-clone"
            type="button"
            class="flex-1 sm:flex-initial px-3 sm:px-4 py-2 sm:py-1.5 text-xs font-bold uppercase tracking-wider text-[#4d4d4d] hover:text-[#171717] transition-all focus-visible:ring-2 focus-visible:ring-[#141413] cursor-pointer text-center"
          >
            <span class="inline-flex items-center justify-center space-x-1.5 sm:space-x-2">
              <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z" />
                <path d="M19 10v2a7 7 0 0 1-14 0v-2" />
                <line x1="12" y1="19" x2="12" y2="22" />
              </svg>
              <span class="truncate">Voice Cloning</span>
            </span>
          </button>
        </div>
      </div>

      <div id="model-progress-container" class="mb-6 p-4 border border-[#e5e0d4] bg-[#fbf9f5]" role="status" aria-live="polite">
        <div class="flex items-center gap-2">
          <span id="model-status-dot" class="w-2 h-2 rounded-full bg-amber-500"></span>
          <span id="model-status-text" class="text-sm font-semibold">Loading speech engine...</span>
        </div>
        <p class="mt-2 text-xs text-[#5c5b56]">Speech generation and voice recording will unlock when the model is ready. You can write your script while it loads.</p>
        <button id="retry-engine-btn" type="button" class="hidden mt-3 px-3 py-2 border border-[#141413] text-xs font-bold cursor-pointer">Retry download</button>
        <span id="model-progress-text" class="hidden"></span>
        <div id="model-progress-bar" class="hidden"></div>
      </div>

      <!-- PANEL 1: Text-to-Speech Settings -->
      <div id="panel-tts" class="space-y-6">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-4">
          <!-- Language Selector -->
          <div class="p-3.5 sm:p-4 bg-[#fbf9f5] border border-[#e5e0d4]">
            <label for="language-select" class="block text-xs font-bold text-[#141413] mb-1.5 sm:mb-2 uppercase tracking-wider">
              Language
            </label>
            <select
              id="language-select"
              class="w-full px-3 py-2 text-base sm:text-sm bg-white border border-[#141413] text-[#141413] font-medium focus-visible:ring-2 focus-visible:ring-[#141413]"
            >
              <option value="english_2026-04" selected>English (Natural)</option>
              <option value="german">German (Deutsch)</option>
              <option value="italian">Italian (Italiano)</option>
              <option value="portuguese">Portuguese (Português)</option>
              <option value="spanish">Spanish (Español)</option>
            </select>
          </div>

          <!-- Predefined Voice & Saved Voices -->
          <div class="p-3.5 sm:p-4 bg-[#fbf9f5] border border-[#e5e0d4]">
            <label for="voice-select" class="block text-xs font-bold text-[#141413] mb-1.5 sm:mb-2 uppercase tracking-wider">
              Choose a Voice
            </label>
            <select
              id="voice-select"
              class="w-full px-3 py-2 text-base sm:text-sm bg-white border border-[#141413] text-[#141413] font-medium focus-visible:ring-2 focus-visible:ring-[#141413]"
            >
              <optgroup label="Default Voices">
                <option value="alba" selected>Alba (Warm & Clear, Female)</option>
                <option value="marius">Marius (Natural, Male)</option>
                <option value="cosette">Cosette (Gentle, Female)</option>
                <option value="jean">Jean (Deep, Male)</option>
                <option value="fantine">Fantine (Soft, Female)</option>
                <option value="javert">Javert (Steady, Male)</option>
                <option value="azelma">Azelma (Bright, Female)</option>
                <option value="eponine">Eponine (Casual, Female)</option>
              </optgroup>
            </select>
          </div>

          <!-- Voice Tone Slider -->
          <div class="p-3.5 sm:p-4 bg-[#fbf9f5] border border-[#e5e0d4]">
            <div class="flex items-center justify-between mb-1.5 sm:mb-2">
              <label for="temperature-slider" class="text-xs font-bold text-[#141413] uppercase tracking-wider">
                Voice Tone
              </label>
              <span id="temperature-val" class="text-xs font-bold text-[#141413] px-1.5 py-0.5 bg-white border border-[#141413]">0.70</span>
            </div>
            <input
              id="temperature-slider"
              type="range"
              min="0.30"
              max="1.00"
              step="0.05"
              value="0.70"
              class="w-full accent-[#141413] cursor-pointer mt-2"
            />
          </div>
        </div>

        <!-- Clone Voice Prompt (Separate horizontal full-width box just below the row) -->
        <div class="p-3.5 bg-[#fbf9f5] border border-[#e5e0d4] flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div class="flex items-center space-x-2 text-xs text-[#5c5b56]">
            <svg class="w-4 h-4 text-[#141413] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z" />
              <path d="M19 10v2a7 7 0 0 1-14 0v-2" />
              <line x1="12" y1="19" x2="12" y2="22" />
            </svg>
            <div>
              <span class="font-bold text-[#141413]">Want your own voice?</span>
              <span class="text-[#5c5b56] block sm:inline sm:ml-1">Record a short sample with your mic to clone any speaking voice.</span>
            </div>
          </div>
          <button
            type="button"
            id="shortcut-clone-voice"
            class="w-full sm:w-auto inline-flex items-center justify-center space-x-1.5 px-3.5 py-2 sm:py-1.5 bg-white border border-[#141413] text-xs font-bold uppercase tracking-wider text-[#141413] hover:bg-[#141413] hover:text-white transition-all cursor-pointer shrink-0"
          >
            <span>+ Clone a Voice</span>
          </button>
        </div>
      </div>

      <!-- PANEL 2: AI Voice Cloning & Private Library -->
      <div id="panel-clone" class="hidden space-y-6">
        
        <!-- Privacy Guarantee Banner -->
        <div class="p-4 bg-[#f4f0e6] border-2 border-[#141413] flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div class="flex items-center space-x-3">
            <div class="w-8 h-8 bg-[#141413] text-white flex items-center justify-center shrink-0">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="11" width="18" height="11" rx="0" ry="0"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
            </div>
            <div>
              <span class="text-xs font-bold text-[#141413] uppercase tracking-wider block">100% Private & Device-Only</span>
              <p class="text-xs text-[#5c5b56]">
                Cloned voices are stored privately in your browser. Your voice data never leaves your device or touches any server.
              </p>
            </div>
          </div>
        </div>

        <!-- Section 1: Microphone Recording & Live Spectrum -->
        <div class="p-5 bg-[#fbf9f5] border border-[#141413] space-y-4">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
            <div>
              <h3 class="text-xs font-bold text-[#141413] uppercase tracking-wider">
                Step 1: Record your voice with the microphone
              </h3>
              <p class="text-xs text-[#5c5b56]">
                Read naturally at your own pace (10 to 20 seconds).
              </p>
            </div>
            <span id="record-timer" class="hidden text-xs text-red-600 font-bold bg-red-50 border border-red-300 px-2.5 py-1 uppercase tracking-wider self-start sm:self-auto">
              00:00 / 00:30
            </span>
          </div>

          <!-- Practice Sentence Box -->
          <div class="p-4 bg-[#f4f0e6] border border-[#141413]">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-bold text-[#141413] uppercase tracking-wider flex items-center space-x-1.5">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                  <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
                </svg>
                <span>Suggested Sentence (Or Speak Anything You Want)</span>
              </span>
              <span class="text-[10px] font-bold text-[#5c5b56] bg-white border border-[#141413] px-2 py-0.5 uppercase tracking-wider">
                Optional
              </span>
            </div>
            <p class="text-xs sm:text-sm font-medium text-[#141413] leading-relaxed italic bg-white p-3.5 border border-[#141413]">
              "When the sunlight strikes raindrops in the air, they act as a prism and form a rainbow. The rainbow is a division of white light into many beautiful colors."
            </p>
            <p class="text-[11px] text-[#5c5b56] mt-2">
              You can speak anything you want, or read this sentence if you need something quick to say. Both work great.
            </p>
          </div>

          <!-- Microphone Action Bar -->
          <p id="recording-tip" class="text-xs text-[#5c5b56] leading-relaxed">
            For best cloning results, use a good microphone and record in a quiet space with minimal background noise.
          </p>
          <div class="p-3.5 sm:p-4 bg-white border border-[#141413] flex flex-col sm:flex-row sm:items-center justify-between gap-3 sm:gap-4 rebus-stamp-shadow-sm">
            <div class="flex items-center space-x-3 w-full sm:w-auto">
              <button
                id="record-btn"
                type="button"
                aria-describedby="recording-tip"
                disabled
                class="w-full sm:w-auto inline-flex items-center justify-center px-5 py-3 sm:py-2.5 border border-[#141413] text-xs font-bold uppercase tracking-wider bg-[#141413] text-white hover:bg-neutral-800 transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
              >
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z" />
                  <path d="M19 10v2a7 7 0 0 1-14 0v-2" />
                  <line x1="12" y1="19" x2="12" y2="22" />
                </svg>
                <span id="record-btn-text">Record with Microphone</span>
              </button>
            </div>
            <p id="mic-status-text" class="text-xs text-[#5c5b56] font-medium text-center sm:text-left">
              Click record and speak anything or read the sentence.
            </p>
          </div>
          <p class="text-[11px] text-[#73726c]">
            If you are using our service you agree to our <a href="/terms" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 hover:text-[#141413] transition-colors">terms</a>.
          </p>

          <!-- Live Mic Audio Spectrum Visualizer -->
          <div class="p-4 bg-white border border-[#141413]">
            <div class="flex items-center justify-between mb-2 text-xs">
              <span class="text-xs font-bold text-[#141413] uppercase tracking-wider flex items-center space-x-2">
                <span id="mic-live-dot" class="w-2.5 h-2.5 rounded-full bg-neutral-300"></span>
                <span>Microphone Wave</span>
              </span>
              <span id="mic-visualizer-hint" class="text-[10px] font-bold text-[#5c5b56] uppercase tracking-wider">
                Waiting for mic
              </span>
            </div>
            <div class="w-full h-20 bg-[#fbf9f5] border border-[#141413] overflow-hidden relative">
              <canvas id="mic-visualizer-canvas" class="w-full h-full block"></canvas>
            </div>
          </div>
        </div>

        <!-- Section 2: Name & Save Cloned Voice (Visible after recording completes!) -->
        <div id="clone-save-step" class="hidden p-5 bg-[#fbf9f5] border-2 border-[#141413] space-y-4 rebus-stamp-shadow-sm">
          <div class="flex items-center justify-between pb-3 border-b border-[#e5e0d4]">
            <div>
              <h3 class="text-xs font-bold text-[#141413] uppercase tracking-wider">
                Step 2: Listen & Name Your Voice
              </h3>
            </div>
            <span id="clone-sample-duration" class="hidden"></span>
          </div>

          <!-- Preview Recorded Audio -->
          <div class="p-4 bg-white border border-[#141413] flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div class="flex items-center space-x-3 w-full sm:w-auto">
              <span class="text-xs font-bold text-[#141413] uppercase tracking-wider">Preview:</span>
              <audio id="voice-preview-audio" controls class="h-9 w-full sm:w-72"></audio>
            </div>
            <button
              id="re-record-btn"
              type="button"
              class="text-xs font-bold uppercase tracking-wider text-[#5c5b56] hover:text-[#141413] underline cursor-pointer"
            >
              Discard & Record Again
            </button>
          </div>

          <!-- Name Your Voice Input -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
            <div>
              <label for="clone-voice-name" class="block text-xs font-bold text-[#141413] uppercase tracking-wider mb-2">
                Name Your Voice
              </label>
              <input
                id="clone-voice-name"
                type="text"
                value="My Voice 1"
                placeholder="e.g. My Voice, Personal Narrator"
                class="w-full px-3 py-2 text-base sm:text-sm bg-white border border-[#141413] text-[#141413] font-medium focus-visible:ring-2 focus-visible:ring-[#141413]"
              />
            </div>
            <div class="flex flex-col justify-end">
              <p class="text-[11px] text-[#5c5b56] leading-relaxed">
                Choose a name so you can easily pick this voice from the Voice menu.
              </p>
            </div>
          </div>

          <!-- Ethical Permission Confirmation -->
          <div class="p-3.5 bg-white border border-[#e5e0d4]">
            <div class="flex items-start space-x-3">
              <input
                id="clone-consent-checkbox"
                type="checkbox"
                checked
                class="mt-0.5 w-4 h-4 text-[#141413] rounded-none border-[#141413] focus:ring-[#141413] cursor-pointer"
              />
              <label for="clone-consent-checkbox" class="text-xs text-[#5c5b56] leading-relaxed cursor-pointer select-none">
                <strong class="text-[#141413] font-bold">Permission:</strong>
                I confirm that I have permission from the speaker to use this voice, and will not use it to mislead anyone.
              </label>
            </div>
            <p id="clone-consent-warning" class="hidden text-xs text-red-600 font-bold mt-2 pl-7">
              You must check this box to confirm permission before saving.
            </p>
          </div>

          <!-- Save Button -->
          <div class="pt-2 space-y-2">
            <div class="flex items-center space-x-3">
              <button
                id="save-clone-btn"
              disabled
                type="button"
                class="w-full sm:w-auto relative min-w-[140px] h-11 sm:h-10 px-6 border border-[#141413] text-xs font-bold uppercase tracking-wider bg-[#141413] text-white hover:bg-neutral-800 transition-all rebus-stamp-shadow-sm inline-flex items-center justify-center cursor-pointer disabled:opacity-75 disabled:cursor-not-allowed"
              >
                <span id="save-clone-btn-content" class="inline-flex items-center space-x-2">
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" />
                    <polyline points="17 21 17 13 7 13 7 21" />
                    <polyline points="7 3 7 8 15 8" />
                  </svg>
                  <span id="save-clone-btn-text">Save Voice</span>
                </span>
                <span id="save-clone-btn-loader" class="hidden items-center justify-center">
                  <svg class="animate-spin w-4 h-4 text-white" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-100" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                  </svg>
                </span>
              </button>
            </div>
            <p class="text-[11px] text-[#73726c]">
              If you are using our service you agree to our <a href="/terms" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 hover:text-[#141413] transition-colors">terms</a>.
            </p>
          </div>

          <!-- Success Banner (hidden by default) -->
          <div id="clone-success-alert" class="hidden p-4 bg-emerald-50 border-2 border-emerald-600 text-emerald-950 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div class="flex items-center space-x-2">
              <span class="w-5 h-5 bg-emerald-600 text-white flex items-center justify-center text-xs font-bold shrink-0">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </span>
              <span class="text-xs font-bold uppercase tracking-wider">Voice Saved!</span>
              <span id="clone-success-name" class="hidden"></span>
            </div>
            <button
              id="clone-success-cta"
              type="button"
              class="px-4 py-2 bg-[#141413] text-white text-xs font-bold uppercase tracking-wider border border-[#141413] hover:bg-neutral-800 transition-all cursor-pointer whitespace-nowrap self-start sm:self-auto"
            >
              Use this Voice →
            </button>
          </div>
        </div>

        <!-- Section 3: Saved Voices Library -->
        <div class="p-5 bg-white border border-[#141413] rebus-stamp-shadow-sm space-y-4">
          <div class="flex items-center justify-between pb-3 border-b border-[#e5e0d4]">
            <div>
              <span class="text-[10px] font-bold text-[#5c5b56] uppercase tracking-widest block mb-0.5">Saved Voices</span>
              <h3 class="text-sm font-bold text-[#141413] uppercase tracking-tight">
                My Saved Voices (<span id="saved-voices-count">0</span>)
              </h3>
            </div>
            <span class="text-[10px] font-bold text-[#5c5b56] px-2 py-1 bg-[#f4f0e6] border border-[#141413] uppercase tracking-wider">
              Stored Safely On Your Device
            </span>
          </div>

          <div id="saved-voices-container" class="space-y-3">
            <div class="p-6 bg-[#fbf9f5] border border-[#e5e0d4] text-center text-xs text-[#5c5b56]">
              No custom voices saved yet. Record your voice using the microphone above to save your first private voice.
            </div>
          </div>
        </div>

      </div>

      <!-- Text-to-Speech Generation & Audio Output Area (Active in TTS mode) -->
      <div id="tts-generation-area" class="space-y-6 mt-6">
        <!-- Text Input Area -->
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <label for="text-input" class="text-xs font-bold text-[#141413] uppercase tracking-wider">
              Text to Speak
            </label>
            <span class="text-xs font-medium text-[#5c5b56]">
              <span id="char-count" class="font-bold text-[#141413]">78</span> characters
            </span>
          </div>

          <div class="relative">
            <textarea
              id="text-input"
              rows="4"
              class="w-full p-3.5 sm:p-4 bg-[#fbf9f5] border border-[#141413] text-base sm:text-sm text-[#141413] placeholder-[#96948c] focus-visible:ring-2 focus-visible:ring-[#141413] resize-y leading-relaxed font-medium"
              placeholder="Type or paste any text to turn into speech…"
            >Welcome! Type or paste any text here to turn it into clear, natural speech.</textarea>
          </div>

          <!-- Sample Presets (No Pills) -->
          <div class="flex flex-wrap items-center gap-1.5 sm:gap-2 pt-1">
            <span class="text-xs font-bold text-[#5c5b56] uppercase tracking-wider mr-1">Sample:</span>
            <button
              type="button"
              class="sample-preset-btn px-2.5 py-1 border border-[#e5e0d4] text-xs font-medium bg-white text-[#5c5b56] hover:text-[#141413] hover:border-[#141413] transition-colors cursor-pointer"
              data-text="Welcome! Type or paste any text here to turn it into clear, natural speech."
            >
              Welcome
            </button>
            <button
              type="button"
              class="sample-preset-btn px-2.5 py-1 border border-[#e5e0d4] text-xs font-medium bg-white text-[#5c5b56] hover:text-[#141413] hover:border-[#141413] transition-colors cursor-pointer"
              data-text="Thank you for reaching out today. I am happy to help you with your question."
            >
              Support
            </button>
            <button
              type="button"
              class="sample-preset-btn px-2.5 py-1 border border-[#e5e0d4] text-xs font-medium bg-white text-[#5c5b56] hover:text-[#141413] hover:border-[#141413] transition-colors cursor-pointer"
              data-text="The sun was setting behind the hills, casting a warm golden glow across the quiet valley."
            >
              Story
            </button>
            <button
              type="button"
              class="sample-preset-btn px-2.5 py-1 border border-[#e5e0d4] text-xs font-medium bg-white text-[#5c5b56] hover:text-[#141413] hover:border-[#141413] transition-colors cursor-pointer"
              data-text="In this quick tutorial, you will learn how to create high quality audio in seconds."
            >
              Tutorial
            </button>
          </div>
        </div>

        <!-- Action Buttons (No Pills) -->
        <div class="mt-6 sm:mt-8 space-y-2.5">
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5 sm:space-x-3">
            <!-- CTA button -->
            <button
              id="generate-btn"
              type="button"
              disabled
