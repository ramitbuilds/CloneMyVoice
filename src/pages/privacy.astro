---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Privacy Policy — Voco Speech"
  description="Privacy Policy for Voco Speech. 100% on-device processing."
>
  <Navbar />
  
  <main id="main-content" class="min-h-[75vh] bg-[#fbf9f5] py-12 md:py-20 border-b border-[#e5e0d4]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumb -->
      <nav class="mb-6 flex items-center space-x-2 text-xs font-bold uppercase tracking-wider text-[#5c5b56]">
        <a href="/" class="hover:text-[#141413] transition-colors">Home</a>
        <span>/</span>
        <span class="text-[#141413]">Privacy Policy</span>
      </nav>

      <!-- Page Header with Rebus Divider -->
      <div class="mb-10 pb-6 border-b border-[#e5e0d4]">
        <span class="text-xs font-bold text-[#5c5b56] uppercase tracking-wider block mb-2">
          // Legal & Data Protection
        </span>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-[#141413] tracking-tight uppercase" style="font-family: 'Space Grotesk', sans-serif;">
          Privacy Policy
        </h1>
        <p class="text-sm sm:text-base text-[#5c5b56] mt-2 leading-relaxed">
          Last updated: October 2026 • Everything runs on your device.
        </p>
      </div>

      <!-- Main Editorial Card -->
      <div class="bg-white border-2 border-[#141413] rebus-stamp-shadow p-6 sm:p-10 space-y-6">
        
        <div class="space-y-4 text-xs sm:text-sm text-[#5c5b56] leading-relaxed">
          <div class="p-4 bg-[#fbf9f5] border border-[#141413]">
            <h2 class="text-xs font-bold uppercase tracking-wider text-[#141413] mb-1">
              1. 100% On-Device Processing
            </h2>
            <p>
              All speech generation and voice cloning run locally inside your browser threads. Your microphone audio, text inputs, and generated speech files are never transmitted to our servers or stored in the cloud.
            </p>
          </div>

          <div class="p-4 bg-[#fbf9f5] border border-[#141413]">
            <h2 class="text-xs font-bold uppercase tracking-wider text-[#141413] mb-1">
              2. No Personal Data Collected
            </h2>
            <p>
              We do not ask for accounts, passwords, email addresses, or payment details. There are no tracking cookies or advertising pixels.
            </p>
          </div>

          <div class="p-4 bg-[#fbf9f5] border border-[#141413]">
            <h2 class="text-xs font-bold uppercase tracking-wider text-[#141413] mb-1">
              3. Microphone Access
            </h2>
            <p>
              Your browser requests microphone permission solely for live recording when you choose to clone a voice. The stream closes immediately when you stop recording.
            </p>
          </div>

          <div class="p-4 bg-[#fbf9f5] border border-[#141413]">
            <h2 class="text-xs font-bold uppercase tracking-wider text-[#141413] mb-1">
              4. Saved Voices
            </h2>
            <p>
              Custom voice profiles are saved exclusively on your computer in your browser's private database (IndexedDB). You can delete them anytime from the Workspace.
            </p>
          </div>
        </div>

        <div class="pt-4 border-t border-[#e5e0d4] flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
          <span class="text-[#5c5b56]">Questions about our privacy architecture?</span>
          <a href="mailto:hi@vocospeech.xyz" class="font-bold text-[#141413] underline font-mono">
            hi@vocospeech.xyz →
          </a>
        </div>

      </div>

    </div>
  </main>

  <Footer />
</Layout>
