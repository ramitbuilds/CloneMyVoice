---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="About Us — Voco Speech"
  description="About Voco Speech — simple, free, on-device voice maker."
>
  <Navbar />
  
  <main id="main-content" class="min-h-[75vh] bg-[#fbf9f5] py-8 sm:py-12 md:py-20 border-b border-[#e5e0d4]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumb -->
      <nav class="mb-4 sm:mb-6 flex items-center space-x-2 text-xs font-bold uppercase tracking-wider text-[#5c5b56]">
        <a href="/" class="hover:text-[#141413] transition-colors">Home</a>
        <span>/</span>
        <span class="text-[#141413]">About Us</span>
      </nav>

      <!-- Page Header with Rebus Divider -->
      <div class="mb-8 sm:mb-10 pb-6 border-b border-[#e5e0d4]">
        <span class="text-xs font-bold text-[#5c5b56] uppercase tracking-wider block mb-2">
          // Our Mission
        </span>
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-[#141413] tracking-tight uppercase" style="font-family: 'Space Grotesk', sans-serif;">
          About Voco Speech
        </h1>
        <p class="text-sm sm:text-base text-[#5c5b56] mt-2 leading-relaxed">
          Fast, natural, and free voice tools running directly inside your browser.
        </p>
      </div>

      <!-- Main Editorial Card -->
      <div class="bg-white border-2 border-[#141413] rebus-stamp-shadow p-4 sm:p-8 md:p-10 space-y-6 mb-8">
        <h2 class="text-base sm:text-lg font-bold text-[#141413] uppercase tracking-tight">
          Simple Voice Creation for Everyone
        </h2>
        <p class="text-xs sm:text-sm text-[#5c5b56] leading-relaxed">
          Voco Speech is an on-device voice maker designed to turn text into natural human speech or duplicate any speaking voice with your microphone in seconds. No cloud uploads, no account hurdles, and no credit card limits.
        </p>

        <div class="pt-6 border-t border-[#e5e0d4] grid grid-cols-1 sm:grid-cols-3 gap-6">
          <div class="space-y-1.5">
            <h3 class="text-xs font-bold text-[#141413] uppercase tracking-wider">100% On-Device</h3>
            <p class="text-xs text-[#5c5b56] leading-relaxed">Runs locally on your computer. Your voice recordings and text never leave your device.</p>
          </div>
          <div class="space-y-1.5">
            <h3 class="text-xs font-bold text-[#141413] uppercase tracking-wider">Free & Unlimited</h3>
            <p class="text-xs text-[#5c5b56] leading-relaxed">No accounts, no subscriptions, and no tokens. Generate as much audio as you need.</p>
          </div>
          <div class="space-y-1.5">
            <h3 class="text-xs font-bold text-[#141413] uppercase tracking-wider">5 Languages</h3>
            <p class="text-xs text-[#5c5b56] leading-relaxed">Authentic intonation in English, Spanish, German, Italian, and Portuguese.</p>
          </div>
        </div>
      </div>

      <!-- Minimal Contact Note -->
      <div class="p-4 sm:p-6 bg-[#f4f0e6] border border-[#141413] flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h3 class="text-xs font-bold uppercase tracking-wider text-[#141413]">Have feedback or questions?</h3>
          <p class="text-xs text-[#5c5b56] mt-0.5">We'd love to hear from you.</p>
        </div>
        <a
          href="mailto:hi@vocospeech.xyz"
          class="font-mono text-xs font-bold text-[#141413] underline"
        >
          hi@vocospeech.xyz →
        </a>
      </div>

    </div>
  </main>

  <Footer />
</Layout>
