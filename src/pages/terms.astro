---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Terms & Conditions — Voco Speech"
  description="Terms and Conditions for using Voco Speech."
>
  <Navbar />
  
  <main id="main-content" class="min-h-[75vh] bg-[#fbf9f5] py-8 sm:py-12 md:py-20 border-b border-[#e5e0d4]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumb -->
      <nav class="mb-4 sm:mb-6 flex items-center space-x-2 text-xs font-bold uppercase tracking-wider text-[#5c5b56]">
        <a href="/" class="hover:text-[#141413] transition-colors">Home</a>
        <span>/</span>
        <span class="text-[#141413]">Terms & Conditions</span>
      </nav>

      <!-- Page Header with Rebus Divider -->
      <div class="mb-8 sm:mb-10 pb-6 border-b border-[#e5e0d4]">
        <span class="text-xs font-bold text-[#5c5b56] uppercase tracking-wider block mb-2">
          // Guidelines & Agreement
        </span>
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-[#141413] tracking-tight uppercase" style="font-family: 'Space Grotesk', sans-serif;">
          Terms & Conditions
        </h1>
        <p class="text-sm sm:text-base text-[#5c5b56] mt-2 leading-relaxed">
          Last updated: October 2026 • Clear and simple rules.
        </p>
      </div>

      <!-- Main Editorial Card -->
      <div class="bg-white border-2 border-[#141413] rebus-stamp-shadow p-4 sm:p-8 md:p-10 space-y-6">
        
        <div class="space-y-4 text-xs sm:text-sm text-[#5c5b56] leading-relaxed">
          <div class="p-4 bg-[#fbf9f5] border border-[#141413]">
            <h2 class="text-xs font-bold uppercase tracking-wider text-[#141413] mb-1">
              1. Free for All Use
            </h2>
            <p>
              Voco Speech is free for personal, educational, and commercial projects. No fees, credits, or paid subscriptions required.
            </p>
          </div>

          <div class="p-4 bg-[#fbf9f5] border border-[#141413]">
            <h2 class="text-xs font-bold uppercase tracking-wider text-[#141413] mb-1">
              2. Responsible Voice Cloning
            </h2>
            <p>
              You must have permission from the speaker before cloning their voice. Deceptive impersonation, fraudulent deepfakes, and harassment are strictly prohibited.
            </p>
          </div>

          <div class="p-4 bg-[#fbf9f5] border border-[#141413]">
            <h2 class="text-xs font-bold uppercase tracking-wider text-[#141413] mb-1">
              3. You Own Your Output
            </h2>
            <p>
              You retain 100% full ownership over all text you input and all audio files generated or downloaded through the service.
            </p>
          </div>

          <div class="p-4 bg-[#fbf9f5] border border-[#141413]">
            <h2 class="text-xs font-bold uppercase tracking-wider text-[#141413] mb-1">
              4. Disclaimer of Liability
            </h2>
            <p>
              The service is provided "as is" without warranty. Processing speed is determined by your browser and local computer hardware.
            </p>
          </div>
        </div>

        <div class="pt-4 border-t border-[#e5e0d4] flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
          <span class="text-[#5c5b56]">Questions regarding these terms?</span>
          <a href="mailto:hi@vocospeech.xyz" class="font-bold text-[#141413] underline font-mono">
            hi@vocospeech.xyz →
          </a>
        </div>

      </div>

    </div>
  </main>

  <Footer />
</Layout>
