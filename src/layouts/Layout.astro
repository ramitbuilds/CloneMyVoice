---
import "../styles/global.css";
import BetaSuggestionModal from "../components/BetaSuggestionModal.astro";

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  canonicalUrl?: string;
  ogImage?: string;
}

const {
  title = "Free TTS & Free Voice Cloning — Unlimited AI Voice Generator | Voco Speech",
  description = "Convert text to speech online free or clone any voice from audio with zero signup. Browser-based, private AI voice generator with natural sounding voices & unlimited TTS.",
  keywords = "Free TTS, Free Voice Cloning, text to speech, voice cloning, free text to speech, AI text to speech, AI TTS, AI voice cloning, free AI TTS, free AI voice cloning, free AI text to speech, free AI voice generator, free voice generator, AI voice cloner, free voice cloner, free unlimited TTS, unlimited text to speech, unlimited voice cloning, free text to speech no signup, free voice cloning no signup, free AI voice cloning unlimited, free AI text to speech unlimited, text to speech online free, voice cloning online free, browser based text to speech, browser based voice cloning, private AI voice cloning, local text to speech, AI voiceover generator, free AI voiceover, natural sounding text to speech, text to speech with cloned voice, clone my voice, clone voice from audio, how to clone my voice for free, how to convert text to speech for free, how to generate AI voiceovers",
  canonicalUrl = "https://www.vocospeech.xyz/",
  ogImage = "https://www.vocospeech.xyz/og-image.svg"
} = Astro.props;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": "https://www.vocospeech.xyz/#webapp",
      "name": "Voco Speech",
      "url": "https://www.vocospeech.xyz/",
      "applicationCategory": "MultimediaApplication",
      "operatingSystem": "All modern browsers (WebAssembly, WebGPU)",
      "description": "Free TTS and Free Voice Cloning web application running locally in the browser. Zero cloud uploads, 100% private AI voice generation, no signup required.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "featureList": [
        "Free TTS (Text to Speech)",
        "Free Voice Cloning from audio",
        "Browser-based local AI processing",
        "Private AI voice cloning with zero cloud uploads",
        "Unlimited text to speech generations",
        "No signup or account registration required",
        "Instant audio preview and WAV download"
      ]
    },
    {
      "@type": "Organization",
      "@id": "https://www.vocospeech.xyz/#organization",
      "name": "Voco Speech",
      "url": "https://www.vocospeech.xyz/",
      "logo": "https://www.vocospeech.xyz/favicon.svg"
    }
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary SEO Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Voco Speech" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Voco Speech" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Voco Speech — Free TTS & Free Voice Cloning" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Voco Speech — Free TTS & Free Voice Cloning" />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <!-- Theme Initializer (Pre-render execution to prevent theme flash; defaults to system theme) -->
    <script is:inline>
      (function() {
        try {
          const stored = localStorage.getItem('theme');
          const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const isDark = stored === 'dark' || (!stored && systemDark) || (stored === 'system' && systemDark);
          if (isDark) {
            document.documentElement.classList.add('dark');
            document.documentElement.setAttribute('data-theme', 'dark');
          } else {
            document.documentElement.classList.remove('dark');
            document.documentElement.setAttribute('data-theme', 'light');
          }
        } catch (e) {}
      })();
    </script>

    <!-- Fonts: Plus Jakarta Sans, Space Grotesk (for brand logo), & Instrument Serif -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-[#fbf9f5] dark:bg-[#121211] text-[#141413] dark:text-[#f5f4ef] min-h-screen selection:bg-[#141413] selection:text-white dark:selection:bg-[#f5f4ef] dark:selection:text-[#121211] font-sans antialiased transition-colors duration-150">
    <!-- Accessibility Skip Link -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 z-50 px-4 py-2 bg-[#141413] text-white border border-[#141413] text-xs font-semibold tracking-wide uppercase">
      Skip to main content
    </a>

    <slot />

    <!-- Global Beta Suggestion System -->
    <BetaSuggestionModal />
  </body>
</html>
